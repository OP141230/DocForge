# AI Provider Configuration
# Options: 'mock' (no API key needed), 'openai', or 'groq' (free!)
AI_PROVIDER=mock

# OpenAI Configuration (only required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_RETRIES=3

# Groq Configuration (only required if AI_PROVIDER=groq)
# Get free API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=3

# Database
DATABASE_URL=sqlite:///./docforge.db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Phase 4: Knowledge Base Configuration
UPLOAD_MAX_SIZE_MB=50
UPLOAD_STORAGE_PATH=./uploads
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,txt,md,html,csv
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Phase 5: Research, Citations & Verification Configuration
# Research limits
RESEARCH_MAX_QUESTIONS=10
RESEARCH_RESULTS_PER_QUESTION=5
RESEARCH_MAX_SOURCES=50
RESEARCH_MAX_USER_URLS=10
RESEARCH_MAX_PAGE_BYTES=5242880

# Verification limits
VERIFICATION_MAX_CLAIMS=100

# Rate limiting (requests per minute)
RESEARCH_REQUEST_LIMIT_PER_MINUTE=10
VERIFICATION_REQUEST_LIMIT_PER_MINUTE=20
